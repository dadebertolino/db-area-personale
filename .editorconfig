# EditorConfig — https://editorconfig.org
# Convenzioni allineate ai WordPress Coding Standards (tab per indentazione).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# YAML/JSON usano spazi (convenzione comunità)
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Markdown: spazi (trailing whitespace significativo per line break)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# package.json: 2 spazi (npm/yarn default)
[package.json]
indent_style = space
indent_size = 2
